[t:template,n:2W_crate_collab_super_base]
{
	doc = "2W_crate_collab_super_base";
	specializes = base_chest;
	[aspect]
	{
		material = steel;
		model = m_i_glb_chest-elemental;
	}
	[body]
	{
		[chore_dictionary]
		{
			chore_prefix = a_i_ice;
			[chore_open]
			{
				skrit = transition;
				[anim_files]
				{
					00 = chest-open;
				}
			}
		}
	}
	[common]
	{
		screen_name = "Chest";
	}
	[inventory]
	{
		drop_at_use_point = true;
	}
}
