	[aspect]
	{
		model = m_i_csl_chest-04;
		[textures]
		{
			0 = b_i_csl_chest-02;
		}
	}
	[attack]
	{
		damage_max = 272;
		damage_min = 172;
	}
	[body]
	{
		[chore_dictionary]
		{
			chore_prefix = a_i_csl;
			[chore_close]
			{
				skrit = transition;
				[anim_files]
				{
					00 = chest-04-open;
				}
			}
			[chore_open]
			{
				skrit = transition;
				[anim_files]
				{
					00 = chest-04-open;
				}
			}
		}
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				[gold*]
				{
					chance = 0.2;
					max = 61808;
					min = 34992;
					min_pile = 16;
					piles = 3 - 5;
				}
				[oneof*]
				{
					chance = 0.5;
					il_main = #weapon/127-153;
					il_main = #armor/225-338;
					il_main = #*/126-151;
					max = 2;
					min = 1;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/153-158;
					il_main = #armor/-rare(1)/271-367;
					il_main = #*/-rare(1)/151-156;
				}
				[oneof*]
				{
					chance = 0.002;
					il_main = #weapon/-unique(2)/153-158;
					il_main = #armor/-unique(2)/271-1903;
					il_main = #*/-unique(2)/151-156;
				}
			}
		}
	}
	[trapped]
	{
		trap = trp_generator_flame_chest;
		fire_event = WE_REQ_USE;
	}
}
