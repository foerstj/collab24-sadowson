[t:template,n:2W_collab_ss_7_crypt_battle_wraith]
{
	category_name = "2W_ss_7_crypt_enemies";
	doc = "2W_Battle_wraith";
	specializes = 2W_base_wraith;
	[actor]
	{
		[skills]
		{
			strength = 38, 0;
			intelligence = 5,  0;
			dexterity = 17, 0;
			melee = 52,  0;
		}
	}
	[aspect]
	{
		experience_value = 42746;
		life = 1083;
		max_life = 1105;
		mana = 171;
		max_mana = 173;
		model = m_c_ecm_wr_pos_1;
		[textures]
		{
			0 = b_c_ecm_wr;
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 268;
		damage_min = 179;
	}
	[defend]
	{
		defense = 619;
	}
	[body]
	{
		[chore_dictionary]
		{
			chore_prefix = a_c_ecm_wr_fs;
			[chore_attack]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files]
				{
					00 = at;
					01 = at-02;
					02 = at-03;
					03 = at-04;
					04 = at-05;
				}
			}
			[chore_default]
			{
				chore_stances = 0;
				skrit = infinite_loop;
				[anim_files]
				{
					00 = dfs;
				}
			}
			[chore_die]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files]
				{
					00 = di;
				}
			}
			[chore_misc]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files]
				{
					slep = ds;
					wake = up;
				}
			}
			[chore_fidget]
			{
				chore_stances = 0;
				skrit = select_fidget;
				[anim_files]
				{
					00 = dff;
				}
			}
			[chore_walk]
			{
				chore_stances = 0;
				skrit = select_walk;
				[anim_files]
				{
					00 = wl;
				}
			}
		}
	}
	[effect_manager_server]
	{
		effect_name = "wraith_flame_head";
		repeat = false;
		start_msg = WE_ENEMY_SPOTTED;
		stop_msg = WE_KILLED;
	}
	[common]
	{
		screen_name = "Battle Wraith";
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script("wraith_tracer","shield_grip");
				action* = call_sfx_script("wraith_tracer","weapon_grip");
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
			}
		}
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				[oneof*]
				{
					chance = 0.05;
					il_main = potion_health_medium;
					il_main = potion_mana_medium;
				}
				[all*]
				{
					chance = 0.02;
					il_main = #spell/41-46;
				}
				[oneof*]
				{
					chance = 0.2;
					il_main = #*/120-125;
					il_main = #armor/223-342;
					il_main = #weapon/153-161;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/159-177;
					il_main = #armor/-rare(1)/384-410;
					il_main = #*/-rare(1)/157-175;
				}
				[oneof*]
				{
					chance = 0.002;
					il_main = #weapon/-unique(2)/159-177;
					il_main = #armor/-unique(2)/384-410;
					il_main = #*/-unique(2)/157-175;
				}
				[gold*]
				{
					chance = 0.15;
					max = 62219;
					min = 35526;
				}
			}
		}
	}
	[mind]
	{
		jat_brain = world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party	= true
			&party_template				= "party_wraith";
	}
	[physics]
	{
		[break_particulate]
		{
			frag_glb_wraith_01 = 1;
			frag_glb_wraith_02 = 1;
			frag_glb_wraith_03 = 2;
			frag_glb_wraith_04 = 1;
			frag_glb_wraith_05 = 3;
			frag_glb_wraith_06 = 2;
			frag_glb_wraith_08 = 1;
		}
	}
}
