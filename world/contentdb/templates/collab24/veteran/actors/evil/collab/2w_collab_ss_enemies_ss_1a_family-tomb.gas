[t:template,n:2W_collab_ss_1a_family-tomb_skeleton_archer]
{
	category_name = "2W_ss_1a_family-tomb_enemies";
	doc = "2W_skeleton_archer";
	specializes = 2W_base_skeleton;
	[actor]
	{
		[skills]
		{
			strength = 29, 0;
			intelligence = 6, 0;
			dexterity = 26, 0;
			ranged = 50, 0;
		}
	}
	[aspect]
	{
		experience_value = 21602;
		life = 454;
		max_life = 454;
		mana = 271;
		max_mana = 273;
	}
	[attack]
	{
		damage_max = 294;
		damage_min = 203;
	}
	[common]
	{
		screen_name = "Skeleton Archer";
	}
	[defend]
	{
		defense = 571;
	}
	[inventory]
	{
		selected_active_location = IL_ACTIVE_RANGED_WEAPON;
		[pcontent]
		{
			[oneof*]
			{
				es_shield_hand = bw_g_c_s_s_r_avg;
			}
			[oneof*]
			{
				[all*]
				{
					chance = 0.03;
					il_main = #spell/33-37;
				}
				[oneof*]
				{
					chance = 0.30;
					il_main = #weapon/130-134;
					il_main = #*/128-133;
					il_main = #armor/208-257;
					il_main = potion_health_medium;
					il_main = potion_mana_medium;
				}
				[oneof*]
				{
					chance = 0.20;
					il_main = potion_health_medium;
					il_main = potion_mana_medium;
				}
				[gold*]
				{
					chance = 0.1;
					max = 61573;
					min = 34536;
				}
			}
		}
	}
	[mind]
	{
		melee_engage_range = 10.0;
		ranged_engage_range = 16.0;
		sight_range = 16.0;
		jat_fidget = world\ai\jobs\common\job_fidget.skrit
			?social							= 0.5
			&meander						= false
			&still							= false;
	}
}
