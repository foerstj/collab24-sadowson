[t:template,n:2W_collab_ss_8_lava_caverns_incumbent_wraith]
{
	category_name = "2W_ss_8_volcano_enemies";
	doc = "2W_Incumbent_wraith";
	specializes = 2W_base_wraith;
	[actor]
	{
		[skills]
		{
			strength = 38, 0;
			intelligence = 5,  0;
			dexterity = 17, 0;
			melee = 52,  0;
		}
	}
	[aspect]
	{
		experience_value = 42818;
		life = 1140;
		max_life = 1163;
		mana = 271;
		max_mana = 273;
		model = m_c_ecm_wr_pos_2;
		[textures]
		{
			0 = b_c_ecm_wr;
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 268;
		damage_min = 179;
	}
	[common]
	{
		screen_name = "Incumbent Wraith";
		membership = monster, party_wraith;
	}
	[defend]
	{
		defense = 622;
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				es_weapon_hand = ax_d_o_2h2b_avg;
			}
			[oneof*]
			{
				[oneof*]
				{
					chance = 0.05;
					il_main = potion_health_medium;
					il_main = potion_mana_medium;
				}
				[all*]
				{
					chance = 0.02;
					il_main = #spell/41-46;
				}
				[oneof*]
				{
					chance = 0.2;
					il_main = #*/120-125;
					il_main = #armor/223-342;
					il_main = #weapon/153-161;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/159-177;
					il_main = #armor/-rare(1)/384-410;
					il_main = #*/-rare(1)/157-175;
				}
				[oneof*]
				{
					chance = 0.002;
					il_main = #weapon/-unique(2)/159-177;
					il_main = #armor/-unique(2)/384-410;
					il_main = #*/-unique(2)/157-175;
				}
				[gold*]
				{
					chance = 0.15;
					max = 62219;
					min = 35526;
				}
			}
		}
	}
	[mind]
	{
		jat_brain = world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party  = true;
	}
	[physics]
	{
		[break_particulate]
		{
			frag_glb_wraith_01 = 1;
			frag_glb_wraith_02 = 1;
			frag_glb_wraith_03 = 2;
			frag_glb_wraith_04 = 1;
			frag_glb_wraith_05 = 3;
			frag_glb_wraith_07 = 1;
		}
	}
}
