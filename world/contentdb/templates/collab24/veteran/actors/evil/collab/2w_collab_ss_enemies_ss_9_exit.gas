[t:template,n:2W_collab_ss_9_exit_darkling]
{
	category_name = "2W_ss_9_exit_enemies";
	doc = "2W_Darkling";
	specializes = 2W_base_darkling;
	[actor]
	{
		[skills]
		{
			strength = 21,  0;
			intelligence = 16, 0;
			dexterity = 15,  0;
			combat_magic = 50,  0;
		}
	}
	[aspect]
	{
		experience_value = 42843;
		life = 881;
		max_life = 903;
		mana = 291;
		max_mana = 293;
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 292;
		damage_min = 199;
	}
	[common]
	{
		screen_name = "Darkling";
	}
	[defend]
	{
		defense = 537;
	}
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other]
		{
			il_active_primary_spell = spell_darkling_spark;
		}
		[pcontent]
		{
			[oneof*]
			{
				[oneof*]
				{
					chance = 0.05;
					il_main = potion_health_medium;
					il_main = potion_mana_medium;
				}
				[all*]
				{
					chance = 0.1;
					il_main = #cmagic/32-47;
				}
				[oneof*]
				{
					chance = 0.15;
					il_main = #*/151-159;
					il_main = #body,ro/300-327;
				}
			}
		}
	}
	[mind]
	{
		jat_fidget = world\ai\jobs\common\job_fidget.skrit;
	}
}
[t:template,n:2W_collab_ss_9_exit_drake_blue]
