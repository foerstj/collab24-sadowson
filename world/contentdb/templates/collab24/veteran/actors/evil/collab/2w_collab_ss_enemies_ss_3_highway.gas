[t:template,n:2W_collab_ss_3_highway_braak]
{
	category_name = "2W_ss_3_highway_enemies";
	doc = "2W_Plains_braak";
	specializes = 2W_base_braak;
	[actor]
	{
		[skills]
		{
			strength = 23,  0;
			intelligence = 13, 0;
			dexterity = 17, 0;
			combat_magic = 49,  0;
		}
	}
	[aspect]
	{
		experience_value = 42651;
		life = 944;
		max_life = 967;
		mana = 237;
		max_mana = 240;
		[textures]
		{
			0 = b_c_ecm_bk-02;
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 264;
		damage_min = 174;
	}
	[body]
	{
		max_move_velocity = 7.0;
	}
	[common]
	{
		screen_name = "Plains Braak";
		membership = party_braak_desert_boss, monster;
	}
	[defend]
	{
		defense = 541;
	}
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other]
		{
			il_active_primary_spell = collab_ss_spell_monster_plains_braak;
		}
		[pcontent]
		{
			[oneof*]
			{
				[oneof*]
				{
					chance = 0.05;
					il_main = potion_health_medium;
					il_main = potion_mana_medium;
				}
				[all*]
				{
					chance = 0.02;
					il_main = #spell/38-46;
				}
				[oneof*]
				{
					chance = 0.25;
					il_main = #*/140-147;
					il_main = #armor/216-295;
					il_main = #weapon/141-148;
					il_main = #body,ro/241-295;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/145-155;
					il_main = #armor/-rare(1)/274-332;
					il_main = #*/-rare(1)/144-153;
				}
				[oneof*]
				{
					chance = 0.002;
					il_main = #weapon/-unique(2)/145-155;
					il_main = #armor/-unique(2)/274-332;
					il_main = #*/-unique(2)/144-153;
				}
				[gold*]
				{
					chance = 0.125;
					max = 61833;
					min = 34865;
				}
			}
		}
	}
	[mind]
	{
		jat_brain = world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party			= true;
		jat_attack_object_melee = world\ai\jobs\common\job_attack_object_melee.skrit
			?run_chance 					= 1.0;
		actor_weapon_preference = WP_MAGIC;
		actor_auto_switches_to_magic = true;
		actor_auto_switches_to_karate = false;
		actor_auto_switches_to_melee = false;
	}
}
[t:template,n:2W_collab_ss_3_highway_braak_boss]
{
	category_name = "2W_ss_3_highway_enemies";
