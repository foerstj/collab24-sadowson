		damage_min = 187;
	}
	[defend]
	{
		defense = 554;
	}
	[body]
	{
		max_move_velocity = 7.0;
	}
	[common]
	{
		screen_name = "Ferocious Braak";
		membership = monster,immune_charm,immune_control,immune_freeze,immune_polymorph,immune_align_change,immune_explode;
		[template_triggers]
		{
			[*]
			{
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				no_trig_bits = true;
				action* = call_sfx_script("unique_ray_yellow(sgx)");
			}
		}
	}
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other]
		{
			il_active_primary_spell = collab_ss_spell_monster_plains_braak;
		}
		[pcontent]
		{
			[all*]
			{
				[all*]
				{
					il_main = #spell/43-46;
				}
				[oneof*]
				{
					il_main = #armor,f/330-357;
					il_main = #weapon/152-155;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/152-167;
					il_main = #armor/-rare(1)/286-345;
					il_main = #*/-rare(1)/156-168;
				}
				[oneof*]
				{
					chance = 0.2;
					il_main = #weapon/-unique(2)/152-167;
					il_main = #armor/-unique(2)/286-345;
					il_main = #*/-unique(2)/150-166;
				}
				[gold*]
				{
					max = 62296;
					min = 35447;
					min_pile = 57;
					piles = 2 - 3;
				}
			}
		}
	}
	[mind]
	{
		jat_fidget = world\ai\jobs\common\job_fidget.skrit
			?social				= 0.7
			&friend_template 	= false
			&friends			= party_braak_desert_boss
			&still				= false;
		jat_brain = world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party			= true
			&party_template						= "party_braak_desert_boss";
		jat_attack_object_melee = world\ai\jobs\common\job_attack_object_melee.skrit
			?run_chance 					= 1.0;
		actor_weapon_preference = WP_MAGIC;
		actor_auto_switches_to_magic = true;
		actor_auto_switches_to_karate = false;
		actor_auto_switches_to_melee = false;
	}
}
