	specializes = 2W_base_braak;
	[actor]
	{
		[skills]
		{
			strength = 23,  0;
			intelligence = 13, 0;
			dexterity = 17, 0;
			combat_magic = 49,  0;
		}
	}
	[aspect]
	{
		experience_value = 42773;
		life = 944;
		max_life = 967;
		mana = 237;
		max_mana = 240;
