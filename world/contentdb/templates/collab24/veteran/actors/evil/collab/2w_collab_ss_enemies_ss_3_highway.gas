[t:template,n:2W_collab_ss_3_highway_kikclaw]
{
	category_name = "2W_ss_3_highway_enemies";
	doc = "2W_kikclaw";
	specializes = 2W_kikclaw_base;
	[actor]
	{
		[skills]
		{
			strength = 24, 0;
			intelligence = 5,  0;
			dexterity = 25, 0;
			melee = 53,  0;
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 264;
		damage_min = 174;
	}
	[defend]
	{
		defense = 559;
	}
	[aspect]
	{
		experience_value = 42626;
		life = 932;
		max_life = 955;
		mana = 137;
		max_mana = 140;
		model = m_c_edm_kc_pos_1;
		[voice]
		{
			[die]
			{
				priority = high;
				* = s_e_die_kikclaw;
			}
			[enemy_spotted]
			{
				priority = high;
				* = s_e_call_kikclaw_SED;
			}
			[hit_critical]
			{
				priority = low;
				* = s_e_hit_kikclaw_SED;
			}
			[hit_glance]
			{
				priority = low;
				* = s_e_hit_kikclaw_SED;
			}
			[hit_solid]
			{
				priority = low;
				* = s_e_hit_kikclaw_SED;
			}
		}
		scale_base = 0.7;
	}
	[common]
	{
		screen_name = "Skitterclaw";
	}
	[guts_manager]
	{
		effect_name = melee_hit_2;
	}
}
