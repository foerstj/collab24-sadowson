[t:template,n:2W_collab_ss_5_dungeon_skeleton_guard]
{
	category_name = "2W_ss_5_dungeon_enemies";
	doc = "2W_Skeleton_Guard";
	specializes = 2W_base_skeleton;
	[actor]
	{
		[skills]
		{
			strength = 38, 0;
			intelligence = 5,  0;
			dexterity = 17, 0;
			melee = 52,  0;
		}
	}
	[aspect]
	{
		experience_value = 42674;
		life = 1002;
		max_life = 1024;
		mana = 427;
		max_mana = 430;
		model = m_c_ecm_sk_pos_2;
	}
	[attack]
	{
		damage_max = 271;
		damage_min = 180;
	}
	[common]
	{
		screen_name = "Skeleton Guard";
		membership = skeleton, party_krug_shaman, monster;
	}
	[defend]
	{
		defense = 561;
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				es_shield_hand = sh_m_g_c_r_s_avg;
			}
			[oneof*]
			{
				es_weapon_hand = ax_d_c_1h1b_avg;
			}
			[oneof*]
			{
				[all*]
				{
					chance = 0.02;
					il_main = #spell/38-46;
				}
				[oneof*]
				{
					chance = 0.25;
					il_main = #*/145-153;
					il_main = #armor/219-305;
					il_main = #weapon/146-155;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/148-161;
					il_main = #armor/-rare(1)/303-351;
					il_main = #*/-rare(1)/147-159;
				}
				[oneof*]
				{
					chance = 0.002;
					il_main = #weapon/-unique(2)/148-161;
					il_main = #armor/-unique(2)/303-351;
					il_main = #*/-unique(2)/147-159;
				}
				[gold*]
				{
					chance = 0.125;
					max = 61938;
					min = 35053;
				}
			}
		}
	}
	[mind]
	{
		jat_brain = world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party	= true;
		jat_fidget = world\ai\jobs\common\job_fidget.skrit;
	}
}
[t:template,n:2W_collab_ss_5_dungeon_skeleton_guard_boss]
{
	category_name = "2W_ss_5_dungeon_enemies";
	doc = "2W_Skeleton_guard_boss";
	specializes = 2W_base_skeleton;
	[actor]
	{
		[skills]
		{
			strength = 29, 0;
			intelligence = 13,  0;
			dexterity = 19, 0;
			melee = 54, 0;
		}
	}
	[aspect]
	{
		experience_value = 42818;
		life = 1083;
		max_life = 1105;
		mana = 438;
		max_mana = 440;
		model = m_c_ecm_sk_pos_2;
		[textures]
		{
			0 = b_c_ecm_skg-02;
		}
		scale_base = 1.2;
	}
	[attack]
	{
		damage_max = 278;
		damage_min = 187;
	}
	[defend]
	{
		defense = 622;
	}
	[common]
	{
		screen_name = "Skeleton Captain";
		membership = skeleton,monster,immune_charm,immune_control,immune_freeze,immune_polymorph,immune_align_change,immune_explode;
		[template_triggers]
		{
			[*]
			{
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				no_trig_bits = true;
				action* = call_sfx_script("unique_light_red(sgx)");
			}
		}
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				es_shield_hand = sh_m_g_c_r_s_avg;
			}
			[oneof*]
			{
				es_weapon_hand = ax_d_c_1h1b_avg;
			}
			[all*]
			{
				[oneof*]
				{
					il_main = #armor,f/330-357;
					il_main = #weapon/152-155;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/158-169;
					il_main = #armor/-rare(1)/358-385;
					il_main = #*/-rare(1)/156-168;
				}
				[oneof*]
				{
					chance = 0.2;
					il_main = #weapon/-unique(2)/158-169;
					il_main = #armor/-unique(2)/358-385;
					il_main = #*/-unique(2)/156-168;
				}
				[gold*]
				{
					max = 62296;
					min = 35447;
					min_pile = 57;
					piles = 2 - 3;
				}
			}
		}
	}
	[mind]
	{
		jat_fidget = world\ai\jobs\common\job_fidget.skrit
			?social				= 0.8
			&friend_template	= false
			&friends			= party_skeleton_guard_boss
			&still				= false;
		jat_brain = world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party	= true
			&party_template				= "party_skeleton_guard_boss";
	}
}
