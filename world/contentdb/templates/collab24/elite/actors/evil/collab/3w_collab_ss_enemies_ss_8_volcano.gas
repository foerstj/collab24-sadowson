[t:template,n:3W_collab_ss_8_lava_caverns_incumbent_wraith]
{
	category_name = "3W_ss_8_volcano_enemies";
	doc = "3W_Incumbent_wraith";
	specializes = 3W_base_wraith;
	[actor]
	{
		[skills]
		{
			strength = 52, 0;
			intelligence = 6,  0;
			dexterity = 22, 0;
			melee = 82,  0;
		}
	}
	[aspect]
	{
		experience_value = 1130952;
		life = 1728;
		max_life = 1766;
		mana = 430;
		max_mana = 434;
		model = m_c_ecm_wr_pos_2;
		[textures]
		{
			0 = b_c_ecm_wr;
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 422;
		damage_min = 282;
	}
	[common]
	{
		screen_name = "Incumbent Wraith";
		membership = monster, party_wraith;
	}
	[defend]
	{
		defense = 965;
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				es_weapon_hand = ax_d_o_2h2b_avg;
			}
			[oneof*]
			{
				[oneof*]
				{
					chance = 0.05;
					il_main = potion_health_large;
					il_main = potion_mana_large;
				}
				[all*]
				{
					chance = 0.02;
					il_main = #spell/60-66;
				}
				[oneof*]
				{
					chance = 0.2;
					il_main = #*/192-197;
					il_main = #armor/356-497;
					il_main = #weapon/226-235;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/233-251;
					il_main = #armor/-rare(1)/547-578;
					il_main = #*/-rare(1)/230-248;
				}
				[oneof*]
				{
					chance = 0.002;
					il_main = #weapon/-unique(2)/233-251;
					il_main = #armor/-unique(2)/547-578;
					il_main = #*/-unique(2)/230-248;
				}
				[gold*]
				{
					chance = 0.15;
					max = 257920;
					min = 158202;
				}
			}
		}
	}
	[mind]
	{
		jat_brain = world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party  = true;
	}
	[physics]
	{
		[break_particulate]
		{
			frag_glb_wraith_01 = 1;
			frag_glb_wraith_02 = 1;
			frag_glb_wraith_03 = 2;
			frag_glb_wraith_04 = 1;
			frag_glb_wraith_05 = 3;
			frag_glb_wraith_07 = 1;
		}
	}
}
