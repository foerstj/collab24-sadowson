[t:template,n:3W_collab_ss_5_dungeon_skeleton_guard]
{
	category_name = "3W_ss_5_dungeon_enemies";
	doc = "3W_Skeleton_Guard";
	specializes = 3W_base_skeleton;
	[actor]
	{
		[skills]
		{
			strength = 52, 0;
			intelligence = 6,  0;
			dexterity = 22, 0;
			melee = 82,  0;
		}
	}
	[aspect]
	{
		experience_value = 1126476;
		life = 1571;
		max_life = 1609;
		mana = 660;
		max_mana = 664;
		model = m_c_ecm_sk_pos_2;
	}
	[attack]
	{
		damage_max = 425;
		damage_min = 283;
	}
	[common]
	{
		screen_name = "Skeleton Guard";
		membership = skeleton, party_krug_shaman, monster;
	}
	[defend]
	{
		defense = 893;
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				es_shield_hand = sh_m_g_c_r_s_avg;
			}
			[oneof*]
			{
				es_weapon_hand = ax_d_c_1h1b_avg;
			}
			[oneof*]
			{
				[all*]
				{
					chance = 0.02;
					il_main = #spell/58-66;
				}
				[oneof*]
				{
					chance = 0.25;
					il_main = #*/217-226;
					il_main = #armor/350-453;
					il_main = #weapon/220-228;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/222-235;
					il_main = #armor/-rare(1)/451-508;
					il_main = #*/-rare(1)/219-232;
				}
				[oneof*]
				{
					chance = 0.002;
					il_main = #weapon/-unique(2)/222-235;
					il_main = #armor/-unique(2)/451-508;
					il_main = #*/-unique(2)/219-232;
				}
				[gold*]
				{
					chance = 0.125;
					max = 257389;
					min = 157026;
				}
			}
		}
	}
	[mind]
	{
		jat_brain = world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party	= true;
		jat_fidget = world\ai\jobs\common\job_fidget.skrit;
	}
}
[t:template,n:3W_collab_ss_5_dungeon_skeleton_guard_boss]
{
	category_name = "3W_ss_5_dungeon_enemies";
	doc = "3W_Skeleton_guard_boss";
	specializes = 3W_base_skeleton;
	[actor]
	{
		[skills]
		{
			strength = 41, 0;
			intelligence = 15,  0;
			dexterity = 24, 0;
			melee = 84, 0;
		}
	}
	[aspect]
	{
		experience_value = 1130952;
		life = 1662;
		max_life = 1701;
		mana = 674;
		max_mana = 678;
		model = m_c_ecm_sk_pos_2;
		[textures]
		{
			0 = b_c_ecm_skg-02;
		}
		scale_base = 1.2;
	}
	[attack]
	{
		damage_max = 434;
		damage_min = 292;
	}
	[defend]
	{
		defense = 965;
	}
	[common]
	{
		screen_name = "Skeleton Captain";
		membership = skeleton,monster,immune_charm,immune_control,immune_freeze,immune_polymorph,immune_align_change,immune_explode;
		[template_triggers]
		{
			[*]
			{
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				no_trig_bits = true;
				action* = call_sfx_script("unique_light_red(sgx)");
			}
		}
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				es_shield_hand = sh_m_g_c_r_s_avg;
			}
			[oneof*]
			{
				es_weapon_hand = ax_d_c_1h1b_avg;
			}
			[all*]
			{
				[oneof*]
				{
					il_main = #armor,f/483-515;
					il_main = #weapon/225-228;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/232-243;
					il_main = #armor/-rare(1)/517-548;
					il_main = #*/-rare(1)/229-240;
				}
				[oneof*]
				{
					chance = 0.2;
					il_main = #weapon/-unique(2)/232-243;
					il_main = #armor/-unique(2)/517-548;
					il_main = #*/-unique(2)/229-240;
				}
				[gold*]
				{
					max = 258065;
					min = 158006;
					min_pile = 57;
					piles = 2 - 3;
				}
			}
		}
	}
	[mind]
	{
		jat_fidget = world\ai\jobs\common\job_fidget.skrit
			?social				= 0.8
			&friend_template	= false
			&friends			= party_skeleton_guard_boss
			&still				= false;
		jat_brain = world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party	= true
			&party_template				= "party_skeleton_guard_boss";
	}
}
