[t:template,n:3W_collab_ss_3_highway_braak]
{
	category_name = "3W_ss_3_highway_enemies";
	doc = "3W_Plains_braak";
	specializes = 3W_base_braak;
	[actor]
	{
		[skills]
		{
			strength = 32,  0;
			intelligence = 15, 0;
			dexterity = 22, 0;
			combat_magic = 78,  0;
		}
	}
	[aspect]
	{
		experience_value = 1125787;
		life = 1505;
		max_life = 1544;
		mana = 381;
		max_mana = 386;
		[textures]
		{
			0 = b_c_ecm_bk-02;
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 416;
		damage_min = 275;
	}
	[body]
	{
		max_move_velocity = 7.0;
	}
	[common]
	{
		screen_name = "Plains Braak";
		membership = party_braak_desert_boss, monster;
	}
	[defend]
	{
		defense = 869;
	}
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other]
		{
			il_active_primary_spell = collab_ss_spell_monster_plains_braak;
		}
		[pcontent]
		{
			[oneof*]
			{
				[oneof*]
				{
					chance = 0.05;
					il_main = potion_health_large;
					il_main = potion_mana_large;
				}
				[all*]
				{
					chance = 0.02;
					il_main = #spell/58-66;
				}
				[oneof*]
				{
					chance = 0.25;
					il_main = #*/212-219;
					il_main = #armor/347-440;
					il_main = #weapon/215-222;
					il_main = #body,ro/377-440;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/219-228;
					il_main = #armor/-rare(1)/416-485;
					il_main = #*/-rare(1)/216-226;
				}
				[oneof*]
				{
					chance = 0.002;
					il_main = #weapon/-unique(2)/219-228;
					il_main = #armor/-unique(2)/416-485;
					il_main = #*/-unique(2)/216-226;
				}
				[gold*]
				{
					chance = 0.125;
					max = 257191;
					min = 156558;
				}
			}
		}
	}
	[mind]
	{
		jat_brain = world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party			= true;
		jat_attack_object_melee = world\ai\jobs\common\job_attack_object_melee.skrit
			?run_chance 					= 1.0;
		actor_weapon_preference = WP_MAGIC;
		actor_auto_switches_to_magic = true;
		actor_auto_switches_to_karate = false;
		actor_auto_switches_to_melee = false;
	}
}
[t:template,n:3W_collab_ss_3_highway_braak_boss]
