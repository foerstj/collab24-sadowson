[t:template,n:3W_collab_ss_3_highway_kikclaw]
{
	category_name = "3W_ss_3_highway_enemies";
	doc = "3W_kikclaw";
	specializes = 3W_kikclaw_base;
	[actor]
	{
		[skills]
		{
			strength = 34, 0;
			intelligence = 6,  0;
			dexterity = 32, 0;
			melee = 83,  0;
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 416;
		damage_min = 275;
	}
	[defend]
	{
		defense = 890;
	}
	[aspect]
	{
		experience_value = 1125012;
		life = 1492;
		max_life = 1531;
		mana = 235;
		max_mana = 239;
		model = m_c_edm_kc_pos_1;
		[voice]
		{
			[die]
			{
				priority = high;
				* = s_e_die_kikclaw;
			}
			[enemy_spotted]
			{
				priority = high;
				* = s_e_call_kikclaw_SED;
			}
			[hit_critical]
			{
				priority = low;
				* = s_e_hit_kikclaw_SED;
			}
			[hit_glance]
			{
				priority = low;
				* = s_e_hit_kikclaw_SED;
			}
			[hit_solid]
			{
				priority = low;
				* = s_e_hit_kikclaw_SED;
			}
		}
		scale_base = 0.7;
	}
	[common]
	{
		screen_name = "Skitterclaw";
	}
	[guts_manager]
	{
		effect_name = melee_hit_2;
	}
}
