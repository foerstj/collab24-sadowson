[t:template,n:3W_collab_ss_7_crypt_battle_wraith]
{
	category_name = "3W_ss_7_crypt_enemies";
	doc = "3W_Battle_wraith";
	specializes = 3W_base_wraith;
	[actor]
	{
		[skills]
		{
			strength = 52, 0;
			intelligence = 6,  0;
			dexterity = 22, 0;
			melee = 82,  0;
		}
	}
	[aspect]
	{
		experience_value = 1128714;
		life = 1662;
		max_life = 1701;
		mana = 284;
		max_mana = 288;
		model = m_c_ecm_wr_pos_1;
		[textures]
		{
			0 = b_c_ecm_wr;
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 422;
		damage_min = 282;
	}
	[defend]
	{
		defense = 962;
	}
	[body]
	{
		[chore_dictionary]
		{
			chore_prefix = a_c_ecm_wr_fs;
			[chore_attack]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files]
				{
					00 = at;
					01 = at-02;
					02 = at-03;
					03 = at-04;
					04 = at-05;
				}
			}
			[chore_default]
			{
				chore_stances = 0;
				skrit = infinite_loop;
				[anim_files]
				{
					00 = dfs;
				}
			}
			[chore_die]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files]
				{
					00 = di;
				}
			}
			[chore_misc]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files]
				{
					slep = ds;
					wake = up;
				}
			}
			[chore_fidget]
			{
				chore_stances = 0;
				skrit = select_fidget;
				[anim_files]
				{
					00 = dff;
				}
			}
			[chore_walk]
			{
				chore_stances = 0;
				skrit = select_walk;
				[anim_files]
				{
					00 = wl;
				}
			}
		}
	}
	[effect_manager_server]
	{
		effect_name = "wraith_flame_head";
		repeat = false;
		start_msg = WE_ENEMY_SPOTTED;
		stop_msg = WE_KILLED;
	}
	[common]
	{
		screen_name = "Battle Wraith";
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script("wraith_tracer","shield_grip");
				action* = call_sfx_script("wraith_tracer","weapon_grip");
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
			}
		}
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				[oneof*]
				{
					chance = 0.05;
					il_main = potion_health_large;
					il_main = potion_mana_large;
				}
				[all*]
				{
					chance = 0.02;
					il_main = #spell/60-66;
				}
				[oneof*]
				{
					chance = 0.2;
					il_main = #*/192-197;
					il_main = #armor/356-497;
					il_main = #weapon/226-235;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/233-251;
					il_main = #armor/-rare(1)/547-578;
					il_main = #*/-rare(1)/230-248;
				}
				[oneof*]
				{
					chance = 0.002;
					il_main = #weapon/-unique(2)/233-251;
					il_main = #armor/-unique(2)/547-578;
					il_main = #*/-unique(2)/230-248;
				}
				[gold*]
				{
					chance = 0.15;
					max = 257920;
					min = 158202;
				}
			}
		}
	}
	[mind]
	{
		jat_brain = world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party	= true
			&party_template				= "party_wraith";
	}
	[physics]
	{
		[break_particulate]
		{
			frag_glb_wraith_01 = 1;
			frag_glb_wraith_02 = 1;
			frag_glb_wraith_03 = 2;
			frag_glb_wraith_04 = 1;
			frag_glb_wraith_05 = 3;
			frag_glb_wraith_06 = 2;
			frag_glb_wraith_08 = 1;
		}
	}
}
