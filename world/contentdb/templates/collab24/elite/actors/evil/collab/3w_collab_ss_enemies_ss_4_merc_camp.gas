[t:template,n:3W_collab_ss_mercenary_melee_base]
{
	doc = "3W_collab_ss_mercenary_melee_base";
	specializes = actor_evil;
	[actor]
	{
		[skills]
		{
			strength = 52, 0;
			intelligence = 6, 0;
			dexterity = 22, 0;
			melee = 82,  0;
		}
	}
	[aspect]
	{
		experience_value = 1123893;
		life = 1715;
		max_life = 1753;
		mana = 235;
		max_mana = 239;
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 422;
		damage_min = 275;
	}
	[defend]
	{
		defense = 962;
	}
	[inventory]
	{
		[pcontent]
		{
			[all*]
			{
				es_feet = collab_ss_mercenary_boots_melee;
				[oneof*]
				{
					es_weapon_hand = collab_ss_mercenary_melee_fullblade;
					es_weapon_hand = collab_ss_mercenary_melee_gladius;
					es_weapon_hand = collab_ss_mercenary_melee_axe;
				}
				[oneof*]
				{
					es_shield_hand = collab_ss_mercenary_kiteshield_01;
					es_shield_hand = collab_ss_mercenary_kiteshield_02;
					es_shield_hand = collab_ss_mercenary_kiteshield_03;
					es_shield_hand = collab_ss_mercenary_kiteshield_04;
					es_shield_hand = collab_ss_mercenary_kiteshield_05;
					es_shield_hand = collab_ss_mercenary_kiteshield_06;
				}
			}
			[oneof*]
			{
				[all*]
				{
					chance = 0.02;
					il_main = #spell/58-66;
				}
				[oneof*]
				{
					chance = 0.25;
					il_main = #*/217-226;
					il_main = #armor/350-453;
					il_main = #weapon/220-228;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/222-235;
					il_main = #armor/-rare(1)/451-508;
					il_main = #*/-rare(1)/219-232;
				}
				[oneof*]
				{
					chance = 0.002;
					il_main = #weapon/-unique(2)/222-235;
					il_main = #armor/-unique(2)/451-508;
					il_main = #*/-unique(2)/219-232;
				}
				[gold*]
				{
					chance = 0.125;
					max = 257389;
					min = 157026;
				}
			}
		}
	}
	[common]
	{
		screen_name = "Mercenary Warrior";
		membership = monster, party_bandit_ranged, bandit;
	}
	[mind]
	{
		disposition_orders = ad_offensive;
		melee_engage_range = 14;
		ranged_engage_range = 14;
		sight_range = 14;
		jat_brain = world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party	= true;
		jat_fidget = world\ai\jobs\common\job_fidget.skrit
			?curious		= 0.75
			&interest		= interest
			&meander		= true
			&still			= false;
	}
}
