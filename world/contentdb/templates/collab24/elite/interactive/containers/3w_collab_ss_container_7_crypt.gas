		model = m_i_csl_chest-04;
		[textures]
		{
			0 = b_i_csl_chest-02;
		}
	}
	[attack]
	{
		damage_max = 427;
		damage_min = 274;
	}
	[body]
	{
		[chore_dictionary]
		{
			chore_prefix = a_i_csl;
			[chore_close]
			{
				skrit = transition;
				[anim_files]
				{
					00 = chest-04-open;
				}
			}
			[chore_open]
			{
				skrit = transition;
				[anim_files]
				{
					00 = chest-04-open;
				}
			}
		}
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				[gold*]
				{
					chance = 0.2;
					max = 257143;
					min = 156874;
					min_pile = 16;
					piles = 3 - 5;
				}
				[oneof*]
				{
					chance = 0.5;
					il_main = #weapon/201-226;
					il_main = #armor/357-492;
					il_main = #*/198-224;
					max = 2;
					min = 1;
				}
				[oneof*]
				{
					chance = 0.004;
					il_main = #weapon/-rare(1)/226-232;
					il_main = #armor/-rare(1)/412-527;
					il_main = #*/-rare(1)/224-229;
				}
				[oneof*]
				{
					chance = 0.002;
					il_main = #weapon/-unique(2)/226-232;
					il_main = #armor/-unique(2)/412-2357;
					il_main = #*/-unique(2)/224-229;
				}
			}
		}
	}
	[trapped]
	{
		trap = trp_generator_flame_chest;
		fire_event = WE_REQ_USE;
	}
}
