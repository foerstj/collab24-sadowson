[conversation_1_before]
{
	[text*]
	{
		screen_text = "Ooooh no. I ain't gonna fight you. Ya be welcome to come in - the boss'l wanna speak to ya.";
	  f scroll_rate = 10.000000;
	}
}
[conversation_hunter]
{
	[text*]
	{
		choice = shop;
	  i order = 0;
		screen_text = "So, you decided to lop off the head of our esteemed employer hmmmm?
That's a bit bold if you ask me.
Still, we'll be camped here for a while longer. The lads have been pulling all sorts of treasure from the crypts but dirtying myself isn't really my thing. But I'd be *glad* to trade a few things with you... Got your purse?";
	  f scroll_rate = 10.000000;
	}
	[text*]
	{
		choice = shop;
		screen_text = "Ah, the returning hero! Your purse still heavy mhmmm? I'd be happy to take if off your hands in exchange for some of our wares...";
	  f scroll_rate = 10.000000;
	}
}
[conversation_mercenary_boss]
{
	[text*]
	{
		activate_quest* = quest_mercenaries,1;
		screen_text = "You! You're the bastard that's been killing me boys! Oooh, I'm gonna enjoy grinding your bones.
That rotting goblin said we'd be rich, pillaging the crypts here, but there nothing but dusty bones and trinkets! Oh I'll enjoy taking my fury out on you - and then I'll go see that prissy lady in her castle! You know she came and asked us to leave! I bet she's hoarding all the gold around here!";
	  f scroll_rate = 10.000000;
	}
}
[conversation_mercenary_guard]
{
	[text*]
	{
		screen_text = "The cave's and the crypt ain't safe. Watch ya step - I won't be goin' down to drag you out!";
	  f scroll_rate = 10.000000;
	}
}
[conversation_piratus_hello]
{
	[text*]
	{
		button_1_text = yes;
		button_1_value = lieutenant_yes;
		screen_text = "Hey, whoa - weapons down friends. You smacked up our leader something good so I ain't gonna even try fight you.
To be honest, the captain sorta had it coming. If you hadn't challenged him, someone else would have. He's been sending us down into some ancient tomb to try and find treasure, but there's just junk in there!
I'm guessing you'll be wanting his shiny purple crystal huh?";
	  f scroll_rate = 10.000000;
	}
}
[conversation_piratus_invalid]
{
	[text*]
	{
		screen_text = "I got nothing to say to you! Git outta my face!";
	  f scroll_rate = 10.000000;
	}
}
[conversation_piratus_pre]
{
	[text*]
	{
		screen_text = "Whatchu lookin' at? It's the boss ya after - not me!";
	  f scroll_rate = 10.000000;
	}
}
[conversation_piratus_yes]
{
	[text*]
	{
		activate_quest* = quest_mercenaries,2;
		complete_quest* = quest_mercenaries;
	  i order = 0;
		screen_text = "Yea so... that might be a problem. We don't exactly have it anymore.
Some of the boys took it into the crypt to see if it'd help ward off the undead so we could loot the place better.
And they haven't come out for a good long while now. So they're probably still down there... and probably dead. You're welcome to go after it, I sure as hell wont!";
	  f scroll_rate = 10.000000;
	}
	[text*]
	{
		screen_text = "Eh? Don't worry about me and the boys. We're gonna packup and get outta here. The cash from that shoddy goblin wasnt worth the trouble to be honest.";
	  f scroll_rate = 10.000000;
	}
}
[conversation_henson_hello]
{
	[text*]
	{
		choice = buy_packmule;
		screen_text = "Well... that was entertaining.
Actually, that was the most entertaining thing that's happened around here for weeks. Tell me, do you do this sort of thing often? Go around killing important leaders and the like?
Actually, don't answer that. i don't want to know. The boss just put me in charge of our mules and I HATE it. But he's dead and... nobodie's going to notice if they go missing. You give me some good coin and I'll swing them over to you.";
	  f scroll_rate = 10.000000;
	}
}
[conversation_henson_two_packmules]
{
	[text*]
	{
		choice = buy_packmule;
		screen_text = "I've still got these two mules here if you want them. Just need to hand over some of that good coin. They'll carry just about anything you want to load on them.";
	  f scroll_rate = 10.000000;
	}
}
[conversation_henson_one_packmule]
{
	[text*]
	{
		choice = buy_packmule;
		screen_text = "Hope the first one ain't giving you any trouble. I don't want it back. How about making it a pair? Still got one if ya interested...";
	  f scroll_rate = 10.000000;
	}
}
[conversation_henson_no_packmule]
{
	[text*]
	{
		screen_text = "We're cleaned out! And none too soon. I'll be off to find something more interesting to do. Good luck in your adventure traveller, I want none of it meself.";
	  f scroll_rate = 10.000000;
	}
}
